<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="18dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自定义"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手动自定义参数、诊断与清理"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <!-- 锁核参数卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="锁核参数" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="默认封锁核心个数（1~4）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="1"
                android:padding="10dp"
                android:text="1"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="检测间隔（秒，5~600）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="number"
                android:maxLength="3"
                android:padding="10dp"
                android:text="30"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认 30 秒一循环；数值越小越灵敏但越耗电，5 秒以下无意义。" />

            <Button
                android:id="@+id/btn_save_params"
                style="@style/BtnPrimary"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存参数" />
        </LinearLayout>

        <!-- 手动自定义限频卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手动自定义输入" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不确定就留空，留空使用日常限频页选的档位。填入的数值会直接写入 config.json。" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="小核簇上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_little"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="例如 2266"
                android:inputType="number"
                android:maxLength="5"
                android:padding="10dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="大核簇上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="例如 1651"
                android:inputType="number"
                android:maxLength="5"
                android:padding="10dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="GPU 上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="例如 500"
                android:inputType="number"
                android:maxLength="5"
                android:padding="10dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_apply_custom"
                style="@style/BtnPrimary"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用并保存" />

            <TextView
                android:id="@+id/txt_custom_hint"
                style="@style/BodyText"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="写入硬件不存在的档位时，内核会自动对齐到最近可用档，属正常现象。" />
        </LinearLayout>

        <!-- 维护卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="诊断 / 测试 / 清理" />

            <Button
                android:id="@+id/btn_diagnose"
                style="@style/BtnGhost"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="环境诊断" />

            <Button
                android:id="@+id/btn_test"
                style="@style/BtnGhost"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="读取模块状态" />

            <Button
                android:id="@+id/btn_clean"
                style="@style/BtnGhost"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清理临时文件" />

            <Button
                android:id="@+id/btn_restore"
                style="@style/BtnGhost"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一键恢复原始状态" />

            <TextView
                android:id="@+id/txt_output"
                style="@style/BodyText"
                android:layout_marginTop="12dp"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="（输出将显示在这里）" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>