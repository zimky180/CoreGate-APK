<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="18dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日常限频"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="日常压低上限降低功耗，游戏时自动恢复"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <!-- 总开关卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启用日常限频"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:text="关闭后会精确恢复到开启前的原始频率。" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_freq_live"
                style="@style/BodyText"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:textColor="@color/text_main"
                android:text="实况读取中…" />

            <Button
                android:id="@+id/btn_refresh_freq"
                style="@style/BtnGhost"
                android:layout_marginTop="10dp"
                android:text="刷新限频实况" />

            <TextView
                style="@style/HintText"
                android:layout_marginTop="8dp"
                android:text="💡 每次刷新都需申请一次 root 操作，短时间大量点击可能被安全机制误判为入侵并弹窗警告；正常点击无此问题，稍等片刻警告即消失，可放心使用。" />
        </LinearLayout>

        <!-- 频率档位卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="频率上限档位" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:text="档位取自本机内核真实支持的频率表，选不到硬件不存在的档。" />

            <!-- 小核 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="小核簇上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/sp_little"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <!-- 大核 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="大核簇上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/sp_big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <!-- GPU -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="GPU 上限（MHz）"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/sp_gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_apply_freq"
                style="@style/BtnPrimary"
                android:layout_marginTop="16dp"
                android:text="应用限频档位" />

            <TextView
                android:id="@+id/txt_freq_hint"
                style="@style/BodyText"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:text="默认 小核 2266 / 大核 1651 / GPU 500，够用且省电。" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>